{
  "name": "react-static-starter-kit",
  "version": "27.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vite preview --port=${PORT:-8080} --strictPort",
    "clean": "rimraf build test-results coverage",
    "prebuild": "npm run clean && npm run lint && npm run typecheck",
    "build": "vite build",
    "dev": "vite dev",
    "test": "npm run test:unit",
    "test:unit": "vitest run lib/** src/** --coverage",
    "test:integration": "vitest run tests/**",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint && stylelint src/**/*.css",
    "lint:fix": "eslint --fix && stylelint src/**/*.css --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@semantic-release/git": "^11.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/debug": "^4.1.13",
    "@types/ejs": "^3.1.5",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sprintf-js": "^1.1.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "dotenv": "^18.0.5",
    "ejs": "^7.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "happy-dom": "^20.14.5",
    "html-minifier-terser": "^7.2.0",
    "jiti": "^2.7.0",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "stylelint": "^17.16.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "sprintf-js": "^1.1.3"
  }
}
